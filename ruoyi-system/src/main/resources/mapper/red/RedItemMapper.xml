<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RedItemMapper">
    
    <resultMap type="RedItem" id="RedItemResult">
        <result property="redItemId"    column="red_item_id"    />
        <result property="redApplyId"    column="red_apply_id"    />
        <result property="originalItemId"    column="original_item_id"    />
        <result property="itemName"    column="item_name"    />
        <result property="quantity"    column="quantity"    />
        <result property="invoiceAmount"    column="invoice_amount"    />
        <result property="taxRate"    column="tax_rate"    />
        <result property="taxAmount"    column="tax_amount"    />
        <result property="sortNo"    column="sort_no"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRedItemVo">
        select red_item_id, red_apply_id, original_item_id, item_name, quantity, invoice_amount, tax_rate, tax_amount, sort_no, create_time, update_time from t_red_item
    </sql>

    <select id="selectRedItemList" parameterType="RedItem" resultMap="RedItemResult">
        <include refid="selectRedItemVo"/>
        <where>  
            <if test="redApplyId != null "> and red_apply_id = #{redApplyId}</if>
            <if test="originalItemId != null "> and original_item_id = #{originalItemId}</if>
            <if test="itemName != null  and itemName != ''"> and item_name like concat('%', #{itemName}, '%')</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="invoiceAmount != null "> and invoice_amount = #{invoiceAmount}</if>
            <if test="taxRate != null "> and tax_rate = #{taxRate}</if>
            <if test="taxAmount != null "> and tax_amount = #{taxAmount}</if>
            <if test="sortNo != null "> and sort_no = #{sortNo}</if>
        </where>
    </select>
    
    <select id="selectRedItemByRedItemId" parameterType="Long" resultMap="RedItemResult">
        <include refid="selectRedItemVo"/>
        where red_item_id = #{redItemId}
    </select>

    <insert id="insertRedItem" parameterType="RedItem" useGeneratedKeys="true" keyProperty="redItemId">
        insert into t_red_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="redApplyId != null">red_apply_id,</if>
            <if test="originalItemId != null">original_item_id,</if>
            <if test="itemName != null">item_name,</if>
            <if test="quantity != null">quantity,</if>
            <if test="invoiceAmount != null">invoice_amount,</if>
            <if test="taxRate != null">tax_rate,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="sortNo != null">sort_no,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="redApplyId != null">#{redApplyId},</if>
            <if test="originalItemId != null">#{originalItemId},</if>
            <if test="itemName != null">#{itemName},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="invoiceAmount != null">#{invoiceAmount},</if>
            <if test="taxRate != null">#{taxRate},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="sortNo != null">#{sortNo},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRedItem" parameterType="RedItem">
        update t_red_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="redApplyId != null">red_apply_id = #{redApplyId},</if>
            <if test="originalItemId != null">original_item_id = #{originalItemId},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="invoiceAmount != null">invoice_amount = #{invoiceAmount},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="sortNo != null">sort_no = #{sortNo},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where red_item_id = #{redItemId}
    </update>

    <delete id="deleteRedItemByRedItemId" parameterType="Long">
        delete from t_red_item where red_item_id = #{redItemId}
    </delete>

    <delete id="deleteRedItemByRedItemIds" parameterType="String">
        delete from t_red_item where red_item_id in 
        <foreach item="redItemId" collection="array" open="(" separator="," close=")">
            #{redItemId}
        </foreach>
    </delete>
</mapper>