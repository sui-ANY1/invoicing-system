<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TaxCredentialMapper">
    
    <resultMap type="TaxCredential" id="TaxCredentialResult">
        <result property="credentialId"    column="credential_id"    />
        <result property="enterpriseId"    column="enterprise_id"    />
        <result property="taxAccount"    column="tax_account"    />
        <result property="taxPassword"    column="tax_password"    />
        <result property="secretKeyVersion"    column="secret_key_version"    />
        <result property="authScope"    column="auth_scope"    />
        <result property="authStartDate"    column="auth_start_date"    />
        <result property="authEndDate"    column="auth_end_date"    />
        <result property="credentialVersion"    column="credential_version"    />
        <result property="usableStatus"    column="usable_status"    />
        <result property="lastVerifyTime"    column="last_verify_time"    />
        <result property="revokeBy"    column="revoke_by"    />
        <result property="revokeTime"    column="revoke_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTaxCredentialVo">
        select credential_id, enterprise_id, tax_account, tax_password, secret_key_version, auth_scope, auth_start_date, auth_end_date, credential_version, usable_status, last_verify_time, revoke_by, revoke_time, del_flag, create_by, create_time, update_by, update_time, remark from t_tax_credential
    </sql>

    <select id="selectTaxCredentialList" parameterType="TaxCredential" resultMap="TaxCredentialResult">
        <include refid="selectTaxCredentialVo"/>
        <where>  
            <if test="enterpriseId != null "> and enterprise_id = #{enterpriseId}</if>
            <if test="taxAccount != null  and taxAccount != ''"> and tax_account = #{taxAccount}</if>
            <if test="taxPassword != null  and taxPassword != ''"> and tax_password = #{taxPassword}</if>
            <if test="secretKeyVersion != null  and secretKeyVersion != ''"> and secret_key_version = #{secretKeyVersion}</if>
            <if test="authScope != null  and authScope != ''"> and auth_scope = #{authScope}</if>
            <if test="authStartDate != null "> and auth_start_date = #{authStartDate}</if>
            <if test="authEndDate != null "> and auth_end_date = #{authEndDate}</if>
            <if test="credentialVersion != null "> and credential_version = #{credentialVersion}</if>
            <if test="usableStatus != null  and usableStatus != ''"> and usable_status = #{usableStatus}</if>
            <if test="lastVerifyTime != null "> and last_verify_time = #{lastVerifyTime}</if>
            <if test="revokeBy != null  and revokeBy != ''"> and revoke_by = #{revokeBy}</if>
            <if test="revokeTime != null "> and revoke_time = #{revokeTime}</if>
        </where>
    </select>
    
    <select id="selectTaxCredentialByCredentialId" parameterType="Long" resultMap="TaxCredentialResult">
        <include refid="selectTaxCredentialVo"/>
        where credential_id = #{credentialId}
    </select>

    <insert id="insertTaxCredential" parameterType="TaxCredential" useGeneratedKeys="true" keyProperty="credentialId">
        insert into t_tax_credential
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="enterpriseId != null">enterprise_id,</if>
            <if test="taxAccount != null">tax_account,</if>
            <if test="taxPassword != null">tax_password,</if>
            <if test="secretKeyVersion != null">secret_key_version,</if>
            <if test="authScope != null">auth_scope,</if>
            <if test="authStartDate != null">auth_start_date,</if>
            <if test="authEndDate != null">auth_end_date,</if>
            <if test="credentialVersion != null">credential_version,</if>
            <if test="usableStatus != null">usable_status,</if>
            <if test="lastVerifyTime != null">last_verify_time,</if>
            <if test="revokeBy != null">revoke_by,</if>
            <if test="revokeTime != null">revoke_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="enterpriseId != null">#{enterpriseId},</if>
            <if test="taxAccount != null">#{taxAccount},</if>
            <if test="taxPassword != null">#{taxPassword},</if>
            <if test="secretKeyVersion != null">#{secretKeyVersion},</if>
            <if test="authScope != null">#{authScope},</if>
            <if test="authStartDate != null">#{authStartDate},</if>
            <if test="authEndDate != null">#{authEndDate},</if>
            <if test="credentialVersion != null">#{credentialVersion},</if>
            <if test="usableStatus != null">#{usableStatus},</if>
            <if test="lastVerifyTime != null">#{lastVerifyTime},</if>
            <if test="revokeBy != null">#{revokeBy},</if>
            <if test="revokeTime != null">#{revokeTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTaxCredential" parameterType="TaxCredential">
        update t_tax_credential
        <trim prefix="SET" suffixOverrides=",">
            <if test="enterpriseId != null">enterprise_id = #{enterpriseId},</if>
            <if test="taxAccount != null">tax_account = #{taxAccount},</if>
            <if test="taxPassword != null">tax_password = #{taxPassword},</if>
            <if test="secretKeyVersion != null">secret_key_version = #{secretKeyVersion},</if>
            <if test="authScope != null">auth_scope = #{authScope},</if>
            <if test="authStartDate != null">auth_start_date = #{authStartDate},</if>
            <if test="authEndDate != null">auth_end_date = #{authEndDate},</if>
            <if test="credentialVersion != null">credential_version = #{credentialVersion},</if>
            <if test="usableStatus != null">usable_status = #{usableStatus},</if>
            <if test="lastVerifyTime != null">last_verify_time = #{lastVerifyTime},</if>
            <if test="revokeBy != null">revoke_by = #{revokeBy},</if>
            <if test="revokeTime != null">revoke_time = #{revokeTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where credential_id = #{credentialId}
    </update>

    <delete id="deleteTaxCredentialByCredentialId" parameterType="Long">
        delete from t_tax_credential where credential_id = #{credentialId}
    </delete>

    <delete id="deleteTaxCredentialByCredentialIds" parameterType="String">
        delete from t_tax_credential where credential_id in 
        <foreach item="credentialId" collection="array" open="(" separator="," close=")">
            #{credentialId}
        </foreach>
    </delete>
</mapper>