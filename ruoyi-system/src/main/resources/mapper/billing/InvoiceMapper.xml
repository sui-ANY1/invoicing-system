<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.InvoiceMapper">
    
    <resultMap type="Invoice" id="InvoiceResult">
        <result property="invoiceId"    column="invoice_id"    />
        <result property="invoiceNo"    column="invoice_no"    />
        <result property="invoiceCode"    column="invoice_code"    />
        <result property="invoiceKind"    column="invoice_kind"    />
        <result property="applyId"    column="apply_id"    />
        <result property="redApplyId"    column="red_apply_id"    />
        <result property="enterpriseId"    column="enterprise_id"    />
        <result property="sellerName"    column="seller_name"    />
        <result property="sellerTaxNumber"    column="seller_tax_number"    />
        <result property="buyerName"    column="buyer_name"    />
        <result property="buyerTaxNumber"    column="buyer_tax_number"    />
        <result property="totalAmount"    column="total_amount"    />
        <result property="totalTax"    column="total_tax"    />
        <result property="totalPriceTax"    column="total_price_tax"    />
        <result property="invoiceDate"    column="invoice_date"    />
        <result property="redStatus"    column="red_status"    />
        <result property="pdfUrl"    column="pdf_url"    />
        <result property="ofdUrl"    column="ofd_url"    />
        <result property="xmlUrl"    column="xml_url"    />
        <result property="fileStatus"    column="file_status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectInvoiceVo">
        select invoice_id, invoice_no, invoice_code, invoice_kind, apply_id, red_apply_id, enterprise_id, seller_name, seller_tax_number, buyer_name, buyer_tax_number, total_amount, total_tax, total_price_tax, invoice_date, red_status, pdf_url, ofd_url, xml_url, file_status, del_flag, create_by, create_time, update_by, update_time, remark from t_invoice
    </sql>

    <select id="selectInvoiceList" parameterType="Invoice" resultMap="InvoiceResult">
        <include refid="selectInvoiceVo"/>
        <where>  
            <if test="invoiceNo != null  and invoiceNo != ''"> and invoice_no = #{invoiceNo}</if>
            <if test="invoiceCode != null  and invoiceCode != ''"> and invoice_code = #{invoiceCode}</if>
            <if test="invoiceKind != null  and invoiceKind != ''"> and invoice_kind = #{invoiceKind}</if>
            <if test="applyId != null "> and apply_id = #{applyId}</if>
            <if test="redApplyId != null "> and red_apply_id = #{redApplyId}</if>
            <if test="enterpriseId != null "> and enterprise_id = #{enterpriseId}</if>
            <if test="sellerName != null  and sellerName != ''"> and seller_name like concat('%', #{sellerName}, '%')</if>
            <if test="sellerTaxNumber != null  and sellerTaxNumber != ''"> and seller_tax_number = #{sellerTaxNumber}</if>
            <if test="buyerName != null  and buyerName != ''"> and buyer_name like concat('%', #{buyerName}, '%')</if>
            <if test="buyerTaxNumber != null  and buyerTaxNumber != ''"> and buyer_tax_number = #{buyerTaxNumber}</if>
            <if test="totalAmount != null "> and total_amount = #{totalAmount}</if>
            <if test="totalTax != null "> and total_tax = #{totalTax}</if>
            <if test="totalPriceTax != null "> and total_price_tax = #{totalPriceTax}</if>
            <if test="invoiceDate != null "> and invoice_date = #{invoiceDate}</if>
            <if test="redStatus != null  and redStatus != ''"> and red_status = #{redStatus}</if>
            <if test="pdfUrl != null  and pdfUrl != ''"> and pdf_url = #{pdfUrl}</if>
            <if test="ofdUrl != null  and ofdUrl != ''"> and ofd_url = #{ofdUrl}</if>
            <if test="xmlUrl != null  and xmlUrl != ''"> and xml_url = #{xmlUrl}</if>
            <if test="fileStatus != null  and fileStatus != ''"> and file_status = #{fileStatus}</if>
        </where>
    </select>
    
    <select id="selectInvoiceByInvoiceId" parameterType="Long" resultMap="InvoiceResult">
        <include refid="selectInvoiceVo"/>
        where invoice_id = #{invoiceId}
    </select>

    <insert id="insertInvoice" parameterType="Invoice" useGeneratedKeys="true" keyProperty="invoiceId">
        insert into t_invoice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no,</if>
            <if test="invoiceCode != null">invoice_code,</if>
            <if test="invoiceKind != null">invoice_kind,</if>
            <if test="applyId != null">apply_id,</if>
            <if test="redApplyId != null">red_apply_id,</if>
            <if test="enterpriseId != null">enterprise_id,</if>
            <if test="sellerName != null">seller_name,</if>
            <if test="sellerTaxNumber != null">seller_tax_number,</if>
            <if test="buyerName != null">buyer_name,</if>
            <if test="buyerTaxNumber != null">buyer_tax_number,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="totalTax != null">total_tax,</if>
            <if test="totalPriceTax != null">total_price_tax,</if>
            <if test="invoiceDate != null">invoice_date,</if>
            <if test="redStatus != null">red_status,</if>
            <if test="pdfUrl != null">pdf_url,</if>
            <if test="ofdUrl != null">ofd_url,</if>
            <if test="xmlUrl != null">xml_url,</if>
            <if test="fileStatus != null">file_status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="invoiceNo != null and invoiceNo != ''">#{invoiceNo},</if>
            <if test="invoiceCode != null">#{invoiceCode},</if>
            <if test="invoiceKind != null">#{invoiceKind},</if>
            <if test="applyId != null">#{applyId},</if>
            <if test="redApplyId != null">#{redApplyId},</if>
            <if test="enterpriseId != null">#{enterpriseId},</if>
            <if test="sellerName != null">#{sellerName},</if>
            <if test="sellerTaxNumber != null">#{sellerTaxNumber},</if>
            <if test="buyerName != null">#{buyerName},</if>
            <if test="buyerTaxNumber != null">#{buyerTaxNumber},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="totalTax != null">#{totalTax},</if>
            <if test="totalPriceTax != null">#{totalPriceTax},</if>
            <if test="invoiceDate != null">#{invoiceDate},</if>
            <if test="redStatus != null">#{redStatus},</if>
            <if test="pdfUrl != null">#{pdfUrl},</if>
            <if test="ofdUrl != null">#{ofdUrl},</if>
            <if test="xmlUrl != null">#{xmlUrl},</if>
            <if test="fileStatus != null">#{fileStatus},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateInvoice" parameterType="Invoice">
        update t_invoice
        <trim prefix="SET" suffixOverrides=",">
            <if test="invoiceNo != null and invoiceNo != ''">invoice_no = #{invoiceNo},</if>
            <if test="invoiceCode != null">invoice_code = #{invoiceCode},</if>
            <if test="invoiceKind != null">invoice_kind = #{invoiceKind},</if>
            <if test="applyId != null">apply_id = #{applyId},</if>
            <if test="redApplyId != null">red_apply_id = #{redApplyId},</if>
            <if test="enterpriseId != null">enterprise_id = #{enterpriseId},</if>
            <if test="sellerName != null">seller_name = #{sellerName},</if>
            <if test="sellerTaxNumber != null">seller_tax_number = #{sellerTaxNumber},</if>
            <if test="buyerName != null">buyer_name = #{buyerName},</if>
            <if test="buyerTaxNumber != null">buyer_tax_number = #{buyerTaxNumber},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="totalTax != null">total_tax = #{totalTax},</if>
            <if test="totalPriceTax != null">total_price_tax = #{totalPriceTax},</if>
            <if test="invoiceDate != null">invoice_date = #{invoiceDate},</if>
            <if test="redStatus != null">red_status = #{redStatus},</if>
            <if test="pdfUrl != null">pdf_url = #{pdfUrl},</if>
            <if test="ofdUrl != null">ofd_url = #{ofdUrl},</if>
            <if test="xmlUrl != null">xml_url = #{xmlUrl},</if>
            <if test="fileStatus != null">file_status = #{fileStatus},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where invoice_id = #{invoiceId}
    </update>

    <delete id="deleteInvoiceByInvoiceId" parameterType="Long">
        delete from t_invoice where invoice_id = #{invoiceId}
    </delete>

    <delete id="deleteInvoiceByInvoiceIds" parameterType="String">
        delete from t_invoice where invoice_id in 
        <foreach item="invoiceId" collection="array" open="(" separator="," close=")">
            #{invoiceId}
        </foreach>
    </delete>
</mapper>