<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.InvoiceItemMapper">
    
    <resultMap type="InvoiceItem" id="InvoiceItemResult">
        <result property="itemId"    column="item_id"    />
        <result property="applyId"    column="apply_id"    />
        <result property="itemName"    column="item_name"    />
        <result property="category"    column="category"    />
        <result property="spec"    column="spec"    />
        <result property="quantity"    column="quantity"    />
        <result property="unit"    column="unit"    />
        <result property="originalPrice"    column="original_price"    />
        <result property="priceCaliber"    column="price_caliber"    />
        <result property="agreedAmount"    column="agreed_amount"    />
        <result property="invoiceAmount"    column="invoice_amount"    />
        <result property="taxRate"    column="tax_rate"    />
        <result property="taxAmount"    column="tax_amount"    />
        <result property="sortNo"    column="sort_no"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectInvoiceItemVo">
        select item_id, apply_id, item_name, category, spec, quantity, unit, original_price, price_caliber, agreed_amount, invoice_amount, tax_rate, tax_amount, sort_no, create_time, update_time from t_invoice_item
    </sql>

    <select id="selectInvoiceItemList" parameterType="InvoiceItem" resultMap="InvoiceItemResult">
        <include refid="selectInvoiceItemVo"/>
        <where>  
            <if test="applyId != null "> and apply_id = #{applyId}</if>
            <if test="itemName != null  and itemName != ''"> and item_name like concat('%', #{itemName}, '%')</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="spec != null  and spec != ''"> and spec = #{spec}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
            <if test="originalPrice != null "> and original_price = #{originalPrice}</if>
            <if test="priceCaliber != null  and priceCaliber != ''"> and price_caliber = #{priceCaliber}</if>
            <if test="agreedAmount != null "> and agreed_amount = #{agreedAmount}</if>
            <if test="invoiceAmount != null "> and invoice_amount = #{invoiceAmount}</if>
            <if test="taxRate != null "> and tax_rate = #{taxRate}</if>
            <if test="taxAmount != null "> and tax_amount = #{taxAmount}</if>
            <if test="sortNo != null "> and sort_no = #{sortNo}</if>
        </where>
    </select>
    
    <select id="selectInvoiceItemByItemId" parameterType="Long" resultMap="InvoiceItemResult">
        <include refid="selectInvoiceItemVo"/>
        where item_id = #{itemId}
    </select>

    <insert id="insertInvoiceItem" parameterType="InvoiceItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into t_invoice_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="applyId != null">apply_id,</if>
            <if test="itemName != null and itemName != ''">item_name,</if>
            <if test="category != null">category,</if>
            <if test="spec != null">spec,</if>
            <if test="quantity != null">quantity,</if>
            <if test="unit != null">unit,</if>
            <if test="originalPrice != null">original_price,</if>
            <if test="priceCaliber != null">price_caliber,</if>
            <if test="agreedAmount != null">agreed_amount,</if>
            <if test="invoiceAmount != null">invoice_amount,</if>
            <if test="taxRate != null">tax_rate,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="sortNo != null">sort_no,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="applyId != null">#{applyId},</if>
            <if test="itemName != null and itemName != ''">#{itemName},</if>
            <if test="category != null">#{category},</if>
            <if test="spec != null">#{spec},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="unit != null">#{unit},</if>
            <if test="originalPrice != null">#{originalPrice},</if>
            <if test="priceCaliber != null">#{priceCaliber},</if>
            <if test="agreedAmount != null">#{agreedAmount},</if>
            <if test="invoiceAmount != null">#{invoiceAmount},</if>
            <if test="taxRate != null">#{taxRate},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="sortNo != null">#{sortNo},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateInvoiceItem" parameterType="InvoiceItem">
        update t_invoice_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="applyId != null">apply_id = #{applyId},</if>
            <if test="itemName != null and itemName != ''">item_name = #{itemName},</if>
            <if test="category != null">category = #{category},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="originalPrice != null">original_price = #{originalPrice},</if>
            <if test="priceCaliber != null">price_caliber = #{priceCaliber},</if>
            <if test="agreedAmount != null">agreed_amount = #{agreedAmount},</if>
            <if test="invoiceAmount != null">invoice_amount = #{invoiceAmount},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="sortNo != null">sort_no = #{sortNo},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where item_id = #{itemId}
    </update>

    <delete id="deleteInvoiceItemByItemId" parameterType="Long">
        delete from t_invoice_item where item_id = #{itemId}
    </delete>

    <delete id="deleteInvoiceItemByItemIds" parameterType="String">
        delete from t_invoice_item where item_id in 
        <foreach item="itemId" collection="array" open="(" separator="," close=")">
            #{itemId}
        </foreach>
    </delete>
</mapper>